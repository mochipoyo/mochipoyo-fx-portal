{
  "name": "mochipoyo-market-portal",
  "private": true,
  "description": "もちぽよ マーケットポータル（静的サイト＋GitHub Actionsでのデータ更新）",
  "engines": { "node": ">=20" },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "update": "node scripts/update-data.mjs",
    "brief": "node scripts/generate-brief.mjs --mode daily",
    "brief:weekly": "node scripts/generate-brief.mjs --mode weekly",
    "preview": "node tests/build-preview.mjs && python3 -m http.server 8080 --directory preview"
  }
}
